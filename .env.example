# PackSense AI - Environment Configuration
# Copy this file to .env and fill in your values.

# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
# For local development, SQLite is used by default.
# Set DATABASE_URL to a PostgreSQL URI to switch:
#   postgresql+asyncpg://user:password@localhost:5432/packsense
DATABASE_URL=sqlite+aiosqlite:///./packsense.db

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: LLM integration (leave blank to disable)
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=gpt-4o
